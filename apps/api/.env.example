# WARNING: Do NOT use default secrets in production or staging environments.
# Generate strong, random secrets using `openssl rand -hex 32` or `openssl rand -base64 32`.
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/unimarket_dev?schema=public"

# Auth & Security
JWT_ACCESS_SECRET="unimarket-jwt-access-secret-key-development-minimum-32-chars"
JWT_REFRESH_SECRET="unimarket-jwt-refresh-secret-key-development-minimum-32-chars"
JWT_ACCESS_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="30d"
CORS_ORIGIN="http://localhost:5173"
COOKIE_DOMAIN=""

# Data Encryption (32-byte hex for AES-256-GCM ID encryption)
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
HMAC_SECRET="unimarket-hmac-secret-for-hash-lookups-dev"

# Storage
STORAGE_PROVIDER="local"
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET="unimarket-media"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_PUBLIC_URL="http://localhost:5000/uploads"

