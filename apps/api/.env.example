# ==============================================================================
# UniMarket Backend API - Environment Configuration Template
# Copy this file to `.env` and replace all placeholder values with your own keys.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>?schema=public
DATABASE_URL="postgresql://<username>:<password>@localhost:5432/unimarket_dev?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/unimarket_dev?schema=public"

# Authentication & JWT
# Generate secure random strings using: openssl rand -base64 32
JWT_ACCESS_SECRET="<your-random-jwt-access-secret-min-32-chars>"
JWT_REFRESH_SECRET="<your-random-jwt-refresh-secret-min-32-chars>"
JWT_ACCESS_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="30d"

# CORS & Cookies
CORS_ORIGIN="http://localhost:5173"
COOKIE_DOMAIN=""

# Data Encryption & Hashing
# ENCRYPTION_KEY must be a 64-character hex string (32 bytes for AES-256-GCM).
# Generate using: openssl rand -hex 32
ENCRYPTION_KEY="<your-64-char-hex-key-from-openssl-rand-hex-32>"
# Generate using: openssl rand -base64 32
HMAC_SECRET="<your-random-hmac-secret-min-32-chars>"

# ==============================================================================
# Media Storage Configuration
# ==============================================================================
# Provider options:
# - "local": Stores/receives files locally (ideal for dev/testing without cloud setup)
# - "r2"   : Cloudflare R2 (Free Tier: 10GB storage, 0 egress fees, 10M reads/mo)
STORAGE_PROVIDER="r2"

# ------------------------------------------------------------------------------
# Cloudflare R2 Storage (Recommended)
# ------------------------------------------------------------------------------
# 1. Cloudflare Account ID:
#    Found in Cloudflare Dashboard -> Overview (right sidebar) or R2 overview URL.
R2_ACCOUNT_ID="<your-cloudflare-account-id>"

# 2. R2 API Token Credentials:
#    Create at: Cloudflare Dashboard -> R2 -> Manage R2 API Tokens -> "Create API Token".
#    Permissions: "Object Read & Write", TTL: according to your preference.
R2_ACCESS_KEY_ID="<your-r2-api-token-access-key-id>"
R2_SECRET_ACCESS_KEY="<your-r2-api-token-secret-access-key>"

# 3. R2 Bucket Name:
#    Create a bucket in Cloudflare Dashboard -> R2 -> "Create bucket".
R2_BUCKET_NAME="unimarket-media"

# 4. R2 Public URL (for viewing uploaded media):
#    Enable public access in your bucket settings:
#    - Option A: Connect Custom Domain (e.g., https://media.yourdomain.com)
#    - Option B: Enable R2.dev public subdomain (e.g., https://pub-xxxxxxxx.r2.dev)
R2_PUBLIC_URL="https://pub-<your-bucket-hash>.r2.dev"

# 5. Optional custom endpoint override (defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com)
R2_ENDPOINT=""
