# ==============================================================================
# UniMarket API - Environment Configuration Template
# ==============================================================================

PORT=5000
NODE_ENV=production

# Database Connection
DATABASE_URL="postgresql://unimarket_user:replace_with_password@localhost:5433/unimarket?schema=public"
RUN_MIGRATIONS=true

# Authentication & JWT Secrets
JWT_ACCESS_SECRET=replace_with_jwt_access_secret_min32_chars
JWT_REFRESH_SECRET=replace_with_jwt_refresh_secret_min32_chars
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d

# CORS & Cookies
CORS_ORIGIN=http://localhost:3000
COOKIE_DOMAIN=

# Data Encryption & Hashing
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
HMAC_SECRET=replace_with_hmac_secret_min32_chars

# Media Storage Configuration
STORAGE_PROVIDER=local

# Cloudflare R2 Storage (Optional)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=unimarket-media
R2_PUBLIC_URL=http://localhost:5000/uploads
R2_ENDPOINT=
