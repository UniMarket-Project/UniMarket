# ==============================================================================
# UniMarket - Master Environment Configuration Template
# Copy this file to `.env` and fill in your secrets before starting the app.
#
# Quick Start:
#   docker compose up -d --build
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Environment
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=5000

# ------------------------------------------------------------------------------
# 2. Docker Compose Port Mappings (Host Ports)
# ------------------------------------------------------------------------------
DB_PORT=5433
API_PORT=5001
WEB_PORT=3000

# ------------------------------------------------------------------------------
# 3. PostgreSQL Database
# ------------------------------------------------------------------------------
DB_USER=unimarket_user
DB_PASSWORD=replace_with_strong_database_password_min16
DB_NAME=unimarket
# DATABASE_URL used for local non-docker development
DATABASE_URL="postgresql://unimarket_user:replace_with_strong_database_password_min16@localhost:5433/unimarket?schema=public"

# Automatically apply database migrations on startup
RUN_MIGRATIONS=true

# ------------------------------------------------------------------------------
# 4. Authentication & JWT Tokens
# ------------------------------------------------------------------------------
# Generate random base64 strings: openssl rand -base64 32
JWT_ACCESS_SECRET=replace_with_jwt_access_secret_min32_chars
JWT_REFRESH_SECRET=replace_with_jwt_refresh_secret_min32_chars
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d

# ------------------------------------------------------------------------------
# 5. Cryptography & Security Secrets
# ------------------------------------------------------------------------------
# ENCRYPTION_KEY must be a 64-char hex string: openssl rand -hex 32
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# HMAC_SECRET must be at least 16 characters
HMAC_SECRET=replace_with_hmac_secret_min32_chars

# ------------------------------------------------------------------------------
# 6. URLs, CORS & Frontend Configuration
# ------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
COOKIE_DOMAIN=

# Vite Frontend Environment Variables
VITE_FRONTEND_URL=http://localhost:3000
VITE_API_BASE_URL=/api/v1
VITE_API_URL=http://localhost:5000
VITE_API_PROXY_TARGET=http://localhost:5000
VITE_PORT=5173

# ------------------------------------------------------------------------------
# 7. Media & File Storage
# ------------------------------------------------------------------------------
# Set to "local" for self-contained disk storage, or "r2" for Cloudflare R2
STORAGE_PROVIDER=local

# Cloudflare R2 Settings (Required when STORAGE_PROVIDER=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=unimarket-media
R2_PUBLIC_URL=http://localhost:5000/uploads
R2_ENDPOINT=
