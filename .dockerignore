# ==============================================================================
# UniMarket - Root Docker Ignore
# ==============================================================================

# Monorepo dependencies
**/node_modules
**/.pnp
**/.pnp.js

# Build artifacts
**/dist
**/build
**/.cache
**/.temp
**/.turbo

# Environment and sensitive secrets
**/.env
**/.env.*
!**/.env.example
!**/.env.docker.example

# Git & CI/CD
.git
.github
.husky
.gitignore

# Tests and coverage
**/tests/
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
coverage/

# OS and Editor metadata
.DS_Store
Thumbs.db
.idea
.vscode
*.swp
*.swo

# Documentation and scratch files
docs/
*.md
!README.md
